{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusHUD",
  "version": "0.2.1",
  "identifier": "com.focushud.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "left-dock",
        "title": "FocusHUD",
        "url": "index.html?dock=left",
        "width": 800,
        "height": 1440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "right-dock",
        "title": "FocusHUD Right",
        "url": "index.html?dock=right",
        "width": 800,
        "height": 1440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "FocusHUD Settings",
        "url": "index.html?dock=settings",
        "width": 560,
        "height": 720,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
